// core_defs.vh -- shared opcode definitions (plain Verilog-2001 macros)
`ifndef CORE_DEFS_VH
`define CORE_DEFS_VH
`define OP_ADD  4'h0
`define OP_SUB  4'h1
`define OP_AND  4'h2
`define OP_OR   4'h3
`define OP_ADDI 4'h4
`define OP_LW   4'h5
`define OP_SW   4'h6
`define OP_BEQ  4'h7
`define OP_BNE  4'h8
`define OP_NOP  4'hF
`endif
